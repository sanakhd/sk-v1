---
import { Image } from 'astro:assets';
import Slab from './primitives/Slab.astro';
import SectionHeading from './primitives/SectionHeading.astro';
import Eyebrow from './primitives/Eyebrow.astro';
import { projects, tile } from '../data/projects';
import { published } from '../data/schema';

const visible = tile(published(projects));

/* The label a project's CTA carries, from where the link actually goes. */
const cta = (project: (typeof visible)[number]) => (project.linkKind === 'live' ? 'View' : 'Code');
---

<Slab tone="ink" id="projects" pad="slab" flush aria-labelledby="projects-heading">
  <div class="inner">
    <SectionHeading title="Projects" tone="ink" id="projects-heading" />

    <ol class="grid">
      {
        visible.map((project) => (
          <li
            class="card"
            data-dir={project.dir}
            style={`--span: ${project.span}; --img-h: ${project.imgH}; --img-w: ${project.imgW}; --img-fit: ${project.imgFit}; --img-bg: ${project.imgBg ?? 'var(--ink-well)'};`}
          >
            <div class="shot">
              <Image src={project.image} alt={`${project.title} screenshot`} loading="lazy" />
            </div>

            <div class="body">
              <Eyebrow tone="accent" class="kind">
                {project.kind}
              </Eyebrow>

              <h3>{project.title}</h3>
              <p class="long">{project.blurb}</p>
              <p class="short">{project.blurbShort}</p>

              <div class="foot">
                <span class="stack">{project.stack}</span>
                {project.link && (
                  <a
                    class="go"
                    href={project.link}
                    data-kind={project.linkKind}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {/* Split so the visible text can be hidden without taking the
                        anchor out of the DOM — the ::after that makes the whole
                        card clickable hangs off it. */}
                    <span class="go-text" aria-hidden="true">
                      {cta(project)} <span>↗</span>
                    </span>
                    <span class="sr-only">
                      {cta(project)} — {project.title}
                    </span>
                  </a>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</Slab>

<style>
  /* The slab is padded tight; its contents carry their own inset. */
  .inner {
    padding-inline: var(--slab-inner-x);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--gap-card);
    /* Stretch, not the design's `start`: cards sharing a row match heights even
       when their copy differs. The footer's margin-top:auto pins the stack line
       and CTA to the bottom, so the extra height reads as deliberate. */
    align-items: stretch;
  }

  .card {
    grid-column: span var(--span);
    /* Anchors the stretched link below. */
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--ink-surface);
    border-radius: var(--r-card);
    overflow: hidden;
    transition: background-color var(--dur) var(--ease);
  }

  .card:hover {
    background: var(--ink-surface-hover);
  }

  /* The full-width feature card lays its image beside the copy instead of above. */
  .card[data-dir='row'] {
    flex-direction: row;
  }

  .shot {
    flex-shrink: 0;
    width: var(--img-w);
    height: var(--img-h);
    background: var(--img-bg, var(--ink-well));
    overflow: hidden;
  }

  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: var(--img-fit, cover);
  }

  .body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    padding: var(--space-36) var(--space-36) var(--space-40);
  }

  .body :global(.kind) {
    font-size: var(--fs-meta-xs);
  }

  h3 {
    font-size: var(--fs-h3);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--track-h3);
    line-height: normal;
  }

  .short {
    display: none;
  }

  p {
    font-size: var(--fs-body-s);
    line-height: var(--lh-relaxed);
    color: var(--on-ink-dim);
    text-wrap: pretty;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-20);
    padding-top: var(--space-18);
    margin-top: auto;
  }

  .stack {
    font-family: var(--font-mono);
    font-size: var(--fs-meta-s);
    color: var(--on-ink-meta);
  }

  .foot a {
    flex-shrink: 0;
    white-space: nowrap;
    font-size: 14px;
    font-weight: var(--fw-medium);
    color: var(--accent);
  }

  .go-text {
    border-bottom: 1px solid var(--accent);
    padding-bottom: var(--space-2);
  }

  /* The whole card is the target, not just the words. One anchor still, so
     keyboard focus, middle-click and "open in new tab" all behave. A card
     without a link has no anchor and stays inert. */
  .go::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  /* Where the cursor pill names the destination, the card's own CTA is saying
     it twice. Hidden, not removed: the anchor carries the ::after above, and
     the screen-reader label inside it. Gated on the same queries Cursor.astro
     checks, so on touch — where there is no pill — the CTA is still there. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .go-text {
      display: none;
    }
  }

  /* "Code ↗" repeated across cards is meaningless out of context to a screen
     reader, so each link carries its project name. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Responsive ------------------------------------------------------------
     The design collapses every card to full width and stacks the feature card's
     image above its copy. */
  @media (max-width: 900px) {
    .card,
    .card[data-dir='row'] {
      grid-column: span 12;
      flex-direction: column;
    }

    .shot {
      width: 100%;
    }
  }

  @media (max-width: 700px) {
    /* A vertical stack of four tall cards is a long scroll past content the
       visitor may not want. The design turns it into a swipeable rail instead. */
    .inner {
      padding-inline: 0;
    }

    .inner :global(.heading) {
      padding-inline: var(--space-20);
    }

    .grid {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      align-items: stretch;
      gap: 14px;
      padding: var(--space-4) var(--space-20) var(--space-20);
      scrollbar-width: none;
    }

    .grid::-webkit-scrollbar {
      display: none;
    }

    .card,
    .card[data-dir='row'] {
      flex: 0 0 76vw;
      scroll-snap-align: center;
      min-height: 400px;
    }

    /* One height for every card on the rail, whatever the desktop value. */
    .shot {
      height: 170px;
    }

    .body {
      padding: var(--space-28) var(--space-24) var(--space-32);
    }

    /* Long blurbs and the stack line do not earn their space at 76vw. */
    .long,
    .stack {
      display: none;
    }

    .short {
      display: block;
    }

    .foot {
      justify-content: flex-end;
    }
  }
</style>
