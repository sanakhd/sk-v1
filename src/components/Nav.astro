---
import Pill from './primitives/Pill.astro';
import { site, nav } from '../data/site';
---

<header class="bar">
  <a class="wordmark" href="#top">{site.wordmark}</a>

  <nav aria-label="Primary">
    <ul>
      {
        nav.map((item) => (
          <li class="anchor-item">
            <Pill href={item.href} variant="ghost" size="sm">
              {item.label}
            </Pill>
          </li>
        ))
      }
      <li>
        <Pill href="#contact" variant="ink" size="sm">Contact</Pill>
      </li>
    </ul>
  </nav>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-16);
    padding: var(--space-24) var(--space-48);
    background: var(--nav-scrim);
    backdrop-filter: blur(var(--nav-blur));
    -webkit-backdrop-filter: blur(var(--nav-blur));
  }

  .wordmark {
    font-weight: var(--fw-extrabold);
    font-size: var(--fs-body-s);
    letter-spacing: var(--track-tight);
    text-transform: uppercase;
    white-space: nowrap;
  }

  ul {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  /* The four pills plus the wordmark cannot fit on a phone at any honest size.
     Since this is a single scrolling page, the anchors are a convenience rather
     than the only way to reach a section — so they drop and Contact stays, which
     is the one thing a visitor might actually want to act on. */
  @media (max-width: 720px) {
    .bar {
      padding: var(--space-16) var(--space-20);
    }

    .anchor-item {
      display: none;
    }
  }
</style>
