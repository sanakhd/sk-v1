---
import Pill from './primitives/Pill.astro';
import { site, nav } from '../data/site';
---

<header class="bar">
  <a class="wordmark" href="#top">{site.wordmark}</a>

  <nav aria-label="Primary">
    <ul>
      {
        nav.map((item) => (
          <li class="anchor-item">
            <Pill href={item.href} variant="ghost" size="sm">
              {item.label}
            </Pill>
          </li>
        ))
      }
      <li>
        <Pill href="#contact" variant="ink" size="sm">Contact</Pill>
      </li>
    </ul>
  </nav>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-16);
    flex-wrap: wrap;
    padding: var(--nav-pad-y) var(--section-pad-x);
    background: var(--nav-scrim);
    backdrop-filter: blur(var(--nav-blur));
    -webkit-backdrop-filter: blur(var(--nav-blur));
  }

  .wordmark {
    font-weight: var(--fw-extrabold);
    font-size: var(--fs-body-s);
    letter-spacing: var(--track-tight);
    text-transform: uppercase;
    white-space: nowrap;
  }

  ul {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  /* No mobile menu — the design wraps the pills onto a second row instead, which
     keeps every anchor reachable without a hamburger. For a single scrolling page
     that is the right trade: the overlay menu in v1 was the least accessible
     thing on the site and it existed to solve a problem this page doesn't have. */
  @media (max-width: 900px) {
    .bar {
      gap: var(--space-12);
    }
  }
</style>
