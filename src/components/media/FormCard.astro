---
/**
 * Animated media for the FORM project card.
 *
 * Translated from Claude Design `FORM Project Card.dc.html`. Pure CSS, no
 * JavaScript, so it stays consistent with the rest of the page.
 *
 * The composition is authored at a fixed 960x560 and scaled to whatever width
 * the card gives it, using container query units. That keeps the phone's
 * proportions exact at any card size instead of cropping it.
 *
 * The hex values below are illustration internals — the bezel gradient, the
 * screen chrome — not site design tokens, so they live here rather than in
 * tokens.css. Anything shared with the site (the accent, the card ground) uses
 * the token.
 */
const days = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
const dates = [10, 11, 12, 13, 14, 15, 16];
const sessions = [
  ['Glute · Strength & Load', '7 exercises'],
  ['Core Finisher', '5 exercises'],
  ['Upper Body', '7 exercises'],
  ['Glute · Shape', '1 exercise'],
];
---

<div
  class="frame"
  role="img"
  aria-label="The FORM app on a phone, showing the weekly session planner"
>
  <div class="stage">
    <div class="ground"></div>
    <div class="glow"></div>

    <div class="phone-pos">
      <div class="drift">
        <div class="bezel">
          <div class="screen">
            <div class="content">
              <div class="title">SESSIONS</div>
              <div class="sub">Plan your week</div>
              <div class="month">Aug 2026</div>

              <div class="week">
                {days.map((d, i) => <div class:list={['dow', { on: i === 2 }]}>{d}</div>)}
              </div>

              <div class="dates">
                {
                  dates.map((n) => (
                    <div class:list={['date', { sel: n === 12, today: n === 16 }]}>{n}</div>
                  ))
                }
              </div>

              <div class="dotrow"><span class="dot"></span></div>

              <div class="restday">
                <div class="meta">Wednesday · Aug 12</div>
                <div class="rest">Rest day</div>
                <div class="hint">Drag a session here to schedule</div>
              </div>

              <div class="listhead">
                <span class="meta">My sessions</span>
                <span class="count">5</span>
                <span class="spacer"></span>
                <span class="plus">+</span>
              </div>

              <div class="list">
                {
                  sessions.map(([name, count]) => (
                    <div class="row">
                      <span class="grip" />
                      <span>
                        <span class="name">{name}</span>
                        <span class="count-sm">{count}</span>
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>

            <div class="tabbar">
              <span>Today</span><span class="on">Sessions</span><span>Progress</span>
            </div>
          </div>
        </div>

        <div class="sheen"><div></div></div>
      </div>
    </div>
  </div>
</div>

<style>
  .frame {
    container-type: inline-size;
    position: relative;
    width: 100%;
    aspect-ratio: 960 / 560;
    overflow: hidden;
    background: var(--ink-surface);
  }

  /* Authored at 960x560, then scaled to the card's width. */
  .stage {
    position: absolute;
    inset: 0;
    width: 960px;
    height: 560px;
    transform-origin: top left;
    transform: scale(calc(100cqw / 960));
    font-family: var(--font-sans);
  }

  .ground {
    position: absolute;
    inset: 0;
    background: radial-gradient(120% 90% at 68% 45%, #24261c 0%, #1d1e16 55%, #17180f 100%);
  }

  .glow {
    position: absolute;
    left: 640px;
    top: 288px;
    width: 620px;
    height: 620px;
    margin: -310px 0 0 -310px;
    border-radius: var(--r-pill);
    background: radial-gradient(
      circle,
      oklch(0.78 0.14 128 / 0.34) 0%,
      oklch(0.78 0.14 128 / 0.14) 34%,
      oklch(0.78 0.14 128 / 0) 64%
    );
    filter: blur(30px);
    animation: breathe 9s ease-in-out infinite;
  }

  .phone-pos {
    position: absolute;
    left: 640px;
    top: 282px;
    transform: translate(-50%, -50%) rotate(-7deg) scale(0.74);
  }

  .drift {
    position: relative;
    animation: drift 8s ease-in-out infinite;
  }

  .bezel {
    width: 320px;
    height: 648px;
    border-radius: var(--r-slab);
    padding: 7px;
    background: linear-gradient(150deg, #3a3b31 0%, #23241c 40%, #14150f 100%);
    box-shadow:
      0 40px 90px oklch(0.2 0.03 128 / 0.55),
      0 0 0 1px oklch(0.78 0.14 128 / 0.1);
  }

  .screen {
    width: 100%;
    height: 100%;
    border-radius: var(--r-card);
    background: #0b0b09;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .content {
    flex: 1;
    padding: 26px 20px 0;
  }

  .title {
    font-size: 38px;
    font-weight: var(--fw-extrabold);
    letter-spacing: -0.02em;
    color: #f4f4ee;
    line-height: 1;
  }

  .sub {
    font-size: 13px;
    color: #7e7f75;
    margin-top: 9px;
  }

  .month {
    font-size: 14px;
    color: #e8e8e0;
    font-weight: var(--fw-medium);
    margin-top: 22px;
  }

  .week,
  .dates,
  .dotrow {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    place-items: center;
  }

  .week {
    gap: 2px;
    margin-top: 14px;
  }

  .dow {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--track-mono-lg);
    color: #61625a;
  }

  .dow.on {
    color: var(--accent);
  }

  .dates {
    gap: 2px;
    margin-top: 10px;
  }

  .date {
    width: 30px;
    height: 30px;
    border-radius: var(--r-pill);
    display: grid;
    place-items: center;
    font-size: 14px;
    color: #d8d9d1;
  }

  .date.sel {
    color: #f4f4ee;
    background: #1f2019;
  }

  .date.today {
    color: #12140c;
    background: var(--accent);
    font-weight: var(--fw-medium);
  }

  .dotrow {
    margin-top: 6px;
  }

  .dot {
    grid-column: 3;
    width: 4px;
    height: 4px;
    border-radius: var(--r-pill);
    background: var(--accent);
    animation: blip 4.5s ease-in-out infinite;
  }

  .restday {
    margin-top: 18px;
    border-radius: var(--r-card);
    border: 1px dashed #2a2b23;
    padding: 18px 20px;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--track-mono-lg);
    text-transform: uppercase;
    color: #6b6c62;
    white-space: nowrap;
  }

  .rest {
    font-size: 17px;
    color: #a9aaa0;
    margin-top: 12px;
  }

  .hint {
    font-size: 12px;
    color: #5e5f56;
    margin-top: 8px;
  }

  .listhead {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 22px;
  }

  .count {
    width: 20px;
    height: 20px;
    border-radius: var(--r-pill);
    background: #1f2019;
    display: grid;
    place-items: center;
    font-size: 10px;
    color: #b9baaf;
  }

  .spacer {
    flex: 1;
  }

  .plus {
    width: 24px;
    height: 24px;
    border-radius: var(--r-pill);
    border: 1px solid #2f3027;
    display: grid;
    place-items: center;
    font-size: 13px;
    color: #b9baaf;
    line-height: 1;
  }

  .list {
    margin-top: 12px;
    border-radius: var(--r-card);
    border: 1px solid #1c1d16;
    overflow: hidden;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid #16170f;
  }

  .row:last-child {
    border-bottom: none;
  }

  .grip {
    width: 6px;
    height: 14px;
    flex-shrink: 0;
    border-radius: var(--r-pill);
    background: repeating-linear-gradient(to bottom, #34352b 0 2px, transparent 2px 5px);
  }

  .name {
    display: block;
    font-size: 14px;
    color: #f0f0e9;
    font-weight: var(--fw-medium);
  }

  .count-sm {
    display: block;
    font-size: 11px;
    color: #62635a;
    margin-top: 3px;
  }

  .tabbar {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 16px 0 20px;
    background: #100f0d;
    border-top: 1px solid #1a1b14;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: var(--track-mono-lg);
    text-transform: uppercase;
    color: #5c5d54;
  }

  .tabbar .on {
    color: #f0f0e9;
  }

  .sheen {
    position: absolute;
    inset: 0;
    border-radius: var(--r-slab);
    overflow: hidden;
    pointer-events: none;
  }

  .sheen > div {
    position: absolute;
    inset: -30%;
    background: linear-gradient(
      115deg,
      transparent 38%,
      rgb(255 255 255 / 0.16) 48%,
      transparent 58%
    );
    animation: sheen 11s ease-in-out infinite;
  }

  @keyframes drift {
    0%,
    100% {
      transform: translateY(-7px);
    }
    50% {
      transform: translateY(7px);
    }
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 0.5;
      transform: scale(1);
    }
    50% {
      opacity: 0.92;
      transform: scale(1.07);
    }
  }

  @keyframes sheen {
    0%,
    100% {
      transform: translate(-30%, -10%);
      opacity: 0.1;
    }
    50% {
      transform: translate(20%, 10%);
      opacity: 0.22;
    }
  }

  @keyframes blip {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }

  /* global.css neutralises durations, but stop them outright so nothing is left
     frozen mid-transform. */
  @media (prefers-reduced-motion: reduce) {
    .glow,
    .drift,
    .dot,
    .sheen > div {
      animation: none;
    }
  }
</style>
